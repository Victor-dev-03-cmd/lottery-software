# Copy this file to .env and fill in values.
# NEVER commit .env to source control.

# PostgreSQL connection string
DATABASE_URL=postgres://lottery_app:CHANGE_ME@localhost:5432/lotterydb

# JWT signing secret — 32+ random bytes, base64 or hex encoded
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_RANDOM_BYTES_HEX

# Bootstrap token — printed to server console on first startup when no device exists.
# Used once during first-device registration. Leave empty to auto-generate.
BOOTSTRAP_TOKEN=

# API server port
PORT=8090
